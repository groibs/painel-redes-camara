# Optional: HTTPS snapshot served by the VPS collector.
# Never prefix these variables with NEXT_PUBLIC_. Never commit real credentials.
PANEL_SOCIAL_SOURCE_URL=
PANEL_SOCIAL_SOURCE_TOKEN=

# Optional: pin an important registered vote by official ID (e.g. 1234567-89).
PANEL_VOTE_ID=

# Optional override for the built-in serverless public Instagram collector.
# On Vercel, VERCEL_URL is used automatically; no VPS is required.
PANEL_PUBLIC_SOCIAL_URL=

# Instagram professional account: official Meta Graph API (prefer over scraping).
# Set in Vercel Environment Variables. Never expose via NEXT_PUBLIC_.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
META_API_VERSION=
# instagram = Instagram Login; facebook = Facebook Login with linked Page
INSTAGRAM_LOGIN=facebook

# Optional dedicated Supabase project. Server-side reads use only the
# publishable/anon key; service-role keys are NEVER stored on Vercel.
PANEL_SUPABASE_URL=
PANEL_SUPABASE_ANON_KEY=

# GitHub Actions secrets (not Vercel variables):
# SUPABASE_URL=https://<dedicated-camara-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=(configure in GitHub Secrets, never in Git)
