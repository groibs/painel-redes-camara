# Only configure credentials directly on the server, never commit or send them in chat.
COLLECTOR_READ_TOKEN=
COLLECTOR_PORT=8715
COLLECTOR_STATE_DIR=/var/lib/rede-camara-social
FOLLOWERS_INTERVAL_SECONDS=900
POSTS_INTERVAL_SECONDS=300
# Public follower counters (Facebook, TikTok, X and YouTube) refresh every 15 min.
PUBLIC_FOLLOWERS_INTERVAL_SECONDS=900

# Set the supported Meta Graph API version selected in the authorized app.
META_API_VERSION=
INSTAGRAM_LOGIN=instagram
# Public handle works without a Meta token for follower count.
INSTAGRAM_HANDLE=
# Set to 0 while no valid Meta token is available; existing posts are preserved.
INSTAGRAM_POSTS_ENABLED=1
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Public handle works without a Meta token for follower count.
FACEBOOK_HANDLE=

# API credentials below are optional. Without them, the collector reads the
# public profile on the interval above using the handles.
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=
YOUTUBE_HANDLE=
X_USER_ID=
X_BEARER_TOKEN=
X_HANDLE=
TIKTOK_ACCESS_TOKEN=
TIKTOK_HANDLE=
